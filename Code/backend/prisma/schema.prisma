// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}
datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
  AGENT
}

enum PropertyStatus {
  DRAFT
  COMING_SOON
  ON_SALE
  SOLD_OUT
  OFFLINE
}

enum PropertyStage {
  PLANNING
  UNDER_CONSTRUCTION
  READY_TO_MOVE
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String?
  role         UserRole @default(USER)
  phone        String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  properties       Property[]       @relation("PropertyAgent")
  interests        Interest[]       @relation("InterestUser")
  assignedInterests Interest[]      @relation("InterestAgent")
  savedProperties  SavedProperty[]
  consents         Consent[]
  campaigns        Campaign[]
  newsArticles     NewsArticle[]
  analyticsEvents AnalyticsEvent[]
  auditLogs        AuditLog[]
  importJobs ImportJob[]
}

model Property {
  id                String   @id @default(cuid())
  sourceKey         String   @unique

  name              String
  location          String
  county            String
  address           String
  postalCode        String

  type              String
  saleType          String

  status            PropertyStatus
  stage             PropertyStage

  priceMin          Decimal
  priceMax          Decimal

  bedroomsMin       Int
  bedroomsMax       Int
  bathroomsMin      Int
  bathroomsMax      Int

  sizeSqm           Int
  sizeCategory      String?

  completionYear    Int?

  description       String?

  listedDate        DateTime?
  publishedAt       DateTime?

  agentId           String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  agent             User? @relation("PropertyAgent", fields: [agentId], references: [id])

  media             PropertyMedia[]
  features          PropertyFeature[]
  valueHistory      PropertyValueHistory[]
  savedBy           SavedProperty[]
  interests         Interest[]
  campaignEvents CampaignEvent[]
  campaignLinks     CampaignProperty[]
  newsLinks         NewsProperty[]
  analyticsEvents   AnalyticsEvent[]
  ragDocuments      RagDocument[]
  aiJobs            AiJob[]

  @@index([county])
  @@index([status])
  @@index([stage])
  @@index([priceMin])
  @@index([bedroomsMin])
  @@index([bathroomsMin])
  @@index([listedDate])
}

enum MediaType {
  IMAGE
  VIDEO
  FLOORPLAN
  DOCUMENT
}

model PropertyMedia {
  id         String    @id @default(cuid())
  propertyId String

  url        String
  type       MediaType
  isPrimary  Boolean   @default(false)
  sortOrder  Int       @default(0)

  createdAt  DateTime  @default(now())

  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model Feature {
  id          String            @id @default(cuid())
  name        String            @unique

  properties  PropertyFeature[]
}

model PropertyFeature {
  propertyId  String
  featureId   String

  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  feature     Feature  @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@id([propertyId, featureId])
}

model PropertyValueHistory {
  id          String   @id @default(cuid())
  propertyId  String

  year        Int
  value       Decimal
  growthPercent Decimal?

  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, year])
  @@index([year])
}
model SavedProperty {
  id         String   @id @default(cuid())
  userId     String
  propertyId String

  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
}

model Interest {
  id             String   @id @default(cuid())
  propertyId     String
  userId         String?
  agentId        String?

  name           String
  email          String
  phone          String?
  message        String?

  dataConsent    Boolean  @default(false)
  followUpSent   Boolean  @default(false)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  property       Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user           User?    @relation("InterestUser", fields: [userId], references: [id], onDelete: SetNull)
  agent          User?    @relation("InterestAgent", fields: [agentId], references: [id], onDelete: SetNull)

  consents Consent[]

  @@index([propertyId])
  @@index([userId])
  @@index([agentId])
  @@index([createdAt])
}

model Consent {
  id          String   @id @default(cuid())
  userId      String?
  interestId  String?

  type        String
  granted     Boolean
  version     String?

  createdAt   DateTime @default(now())

  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  interest   Interest? @relation(fields: [interestId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([interestId])
}

enum CampaignStatus {
  DRAFT
  SENT
  FAILED
}

enum CampaignEventType {
  SENT
  FAILED
  OPENED
  CLICKED
  INTEREST
  SAVED
  UNSUBSCRIBED
}

enum SubscriberStatus {
  ACTIVE
  UNSUBSCRIBED
}

model Subscriber {
  id              String           @id @default(cuid())
  name            String
  email           String           @unique
  phone           String?

  status          SubscriberStatus @default(ACTIVE)
  subscribedAt    DateTime         @default(now())
  unsubscribedAt  DateTime?

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  campaignRecipients CampaignRecipient[]
  campaignEvents     CampaignEvent[]

  @@index([status])
  @@index([subscribedAt])
}

model Campaign {
  id           String         @id @default(cuid())
  subject      String
  status       CampaignStatus @default(DRAFT)
  templateHtml String?

  createdById  String?
  sentAt       DateTime?

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  createdBy    User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)

  properties   CampaignProperty[]
  recipients   CampaignRecipient[]
  events       CampaignEvent[]
  analyticsEvents AnalyticsEvent[]

  @@index([status])
  @@index([createdAt])
}

model CampaignProperty {
  campaignId String
  propertyId String

  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([campaignId, propertyId])
}

model CampaignRecipient {
  id           String   @id @default(cuid())
  campaignId   String
  subscriberId String

  status       String   @default("PENDING")

  sentAt       DateTime?
  deliveredAt  DateTime?
  failedAt     DateTime?
  errorMessage String?

  campaign     Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  subscriber   Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@unique([campaignId, subscriberId])
  @@index([campaignId])
  @@index([subscriberId])
  @@index([status])
}

model CampaignEvent {
  id           String             @id @default(cuid())
  campaignId   String
  subscriberId String?
  propertyId   String?

  type         CampaignEventType
  occurredAt   DateTime           @default(now())

  campaign     Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  subscriber   Subscriber? @relation(fields: [subscriberId], references: [id], onDelete: SetNull)
  property     Property?  @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([campaignId])
  @@index([subscriberId])
  @@index([propertyId])
  @@index([type])
  @@index([occurredAt])
}

model CampaignTemplate {
  id          String   @id @default(cuid())
  name        String
  subject     String?
  htmlContent String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
model NewsArticle {
  id          String   @id @default(cuid())

  title       String
  summary     String?
  content     String?
  imageUrl    String?

  published   Boolean  @default(false)
  publishDate DateTime?

  createdById String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy   User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  properties  NewsProperty[]

  @@index([published])
  @@index([publishDate])
}

model NewsProperty {
  newsArticleId String
  propertyId   String

  newsArticle  NewsArticle @relation(fields: [newsArticleId], references: [id], onDelete: Cascade)
  property     Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([newsArticleId, propertyId])
  @@index([propertyId])
}

enum AnalyticsEventType {
  PROPERTY_VIEW
  PROPERTY_SAVE
  PROPERTY_COMPARE
  INTEREST_SUBMITTED
  MORTGAGE_CALCULATED
  NEWS_VIEW
  CAMPAIGN_CLICK
}

model AnalyticsEvent {
  id         String             @id @default(cuid())

  userId     String?
  propertyId String?
  campaignId String?

  eventType  AnalyticsEventType
  metadata   Json?

  createdAt  DateTime           @default(now())

  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  property   Property?   @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  campaign   Campaign?   @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([propertyId])
  @@index([campaignId])
  @@index([eventType])
  @@index([createdAt])
}
enum RagSourceType {
  PROPERTY
  NEWS
  FLOORPLAN
  FAQ
  DOCUMENT
}

enum AiJobType {
  HOME_TOUR_GENERATION
  RAG_QUERY
}

enum AiJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ImportJobType {
  PROPERTY_IMPORT
  SUBSCRIBER_IMPORT
}

enum ImportJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model RagDocument {
  id         String         @id @default(cuid())
  propertyId String?
  title      String
  content    String
  sourceType RagSourceType

  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  property   Property?      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  chunks     RagChunk[]

  @@index([propertyId])
  @@index([sourceType])
}

model RagChunk {
  id         String      @id @default(cuid())
  documentId String
  content    String

  /*
   * We will add the pgvector embedding column
   * after the relational schema is working.
   */

  createdAt  DateTime @default(now())

  document   RagDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model AiJob {
  id         String      @id @default(cuid())
  propertyId String?

  type       AiJobType
  status     AiJobStatus @default(PENDING)

  prompt     String?
  result     Json?
  error      String?
  attempts   Int         @default(0)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([propertyId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model ImportJob {
  id             String          @id @default(cuid())

  type           ImportJobType
  status         ImportJobStatus @default(PENDING)

  filename       String
  totalRows      Int             @default(0)
  successfulRows Int             @default(0)
  failedRows     Int             @default(0)

  errors         Json?

  createdById    String?

  createdAt      DateTime        @default(now())
  completedAt    DateTime?

  createdBy      User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())

  userId     String?

  action     String
  entityType String
  entityId   String?
  metadata   Json?

  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
}