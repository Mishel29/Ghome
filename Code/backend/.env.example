DATABASE_URL=postgresql://user:password@localhost:5432/database

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=2525
SMTP_USER=your-brevo-smtp-login
SMTP_PASSWORD=your-brevo-smtp-key
# Configure this same value in the Brevo transactional webhook URL.
BREVO_WEBHOOK_SECRET=replace-with-a-long-random-secret

MAIL_FROM_EMAIL=your-verified-email@example.com
MAIL_FROM_NAME=Harborstone Homes

PUBLIC_APP_URL=http://localhost:5173
PUBLIC_BACKEND_URL=http://localhost:4000

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me