DATABASE_URL=postgresql://user:password@localhost:5432/database

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=2525
SMTP_USER=your-brevo-smtp-login
SMTP_PASSWORD=your-brevo-smtp-key

MAIL_FROM_EMAIL=your-verified-email@example.com
MAIL_FROM_NAME=Harborstone Homes

PUBLIC_APP_URL=http://localhost:5173
PUBLIC_BACKEND_URL=http://localhost:4000

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Optional: enables NVIDIA-grounded language responses. Without this, the
# assistant still returns deterministic answers from published property records.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
